DEBUG=True
SECRET_KEY=dev-change-this-local-key-before-use
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://sitrap:sitrap-local@127.0.0.1:5432/sitrap
SESSION_COOKIE_AGE=43200
OFFLINE_PREPARATION_DAYS=7
# Production: DEBUG=False, strong secret, exact hostname and HTTPS origins.
# CSRF_TRUSTED_ORIGINS=https://sitrap.example.org

PUSH_ENABLED=False
# VAPID_PRIVATE_KEY: base64url DER PKCS8 P-256, never commit actual keys.
# VAPID_PUBLIC_KEY: base64url uncompressed P-256 public point.
# VAPID_SUBJECT=mailto:ops@example.org
